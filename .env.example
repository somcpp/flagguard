# Copy this file to `.env` and fill in the values. Never commit `.env`.

# --- Flagsmith -------------------------------------------------------------
# Organisation API key: Flagsmith dashboard -> Organisation Settings -> API Keys.
# Used by the agent to create flags, segments and rollouts (Admin API).
FLAGSMITH_API_KEY=

# Numeric ID of the Flagsmith project FlagGuard manages
# (visible in the dashboard URL: /project/<id>/...).
FLAGSMITH_PROJECT_ID=

# Only change this if you self-host Flagsmith.
FLAGSMITH_API_URL=https://api.flagsmith.com

# --- LLM (optional) --------------------------------------------------------
# Without a key FlagGuard runs in offline "rules" mode.
# Supported providers: gemini | openai-compatible
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=

# --- Logging ---------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
