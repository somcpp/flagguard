# Copy this file to `.env` and fill in the values. Never commit `.env`.

# --- Flagsmith -------------------------------------------------------------
# Organisation API key: Flagsmith dashboard -> Organisation Settings -> API Keys.
# Used by the agent to create flags, segments and rollouts (Admin API).
FLAGSMITH_API_KEY=

# Numeric ID of the Flagsmith project FlagGuard manages
# (visible in the dashboard URL: /project/<id>/...).
FLAGSMITH_PROJECT_ID=

# Only change this if you self-host Flagsmith.
FLAGSMITH_API_URL=https://api.flagsmith.com

# --- Demo shop (examples/shop) --------------------------------------------
# Server-side environment key for the environment the shop runs in, e.g. Production
# (Environment -> Settings -> SDK Keys, starts with "ser."). Leave empty for offline mode.
FLAGSMITH_SERVER_KEY=

# --- LLM (optional) --------------------------------------------------------
# Without any key FlagGuard runs in rules-only mode.
#
# Recommended: several free keys via keyhopper (https://github.com/somcpp/keyhopper).
# Comma-separated. When a key is rate-limited or a provider is overloaded, FlagGuard
# hops to the next key, model, then provider.
GROQ_API_KEYS=
GEMINI_API_KEYS=
# GROQ_MODELS=openai/gpt-oss-120b
# GEMINI_MODELS=gemini-2.5-flash
# KEYHOPPER_PROVIDERS=groq,gemini
#
# Alternative: a single key. LLM_PROVIDER: auto | keyhopper | gemini | openai-compatible
LLM_PROVIDER=auto
LLM_API_KEY=
LLM_MODEL=

# --- Logging ---------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
